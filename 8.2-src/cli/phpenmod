#!/bin/sh
set -eu

PHP_MAJOR_MINOR="8.2"
CONF_ROOT="/etc/php/${PHP_MAJOR_MINOR}"
MODS_DIR="${CONF_ROOT}/mods-available"
SAPI_FILTER="ALL"
QUIET=0

usage() {
    echo "Usage: phpenmod [-v ${PHP_MAJOR_MINOR}|ALL] [-s SAPI|ALL] [-q] module[/priority] [module...]" >&2
    exit 1
}

while getopts "v:s:qh" opt; do
    case "$opt" in
        v)
            if [ "$OPTARG" != "$PHP_MAJOR_MINOR" ] && [ "$OPTARG" != "ALL" ]; then
                echo "Error: phpenmod in this image only supports PHP ${PHP_MAJOR_MINOR} (got '$OPTARG')." >&2
                exit 1
            fi
            ;;
        s) SAPI_FILTER="$OPTARG" ;;
        q) QUIET=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

if [ $# -eq 0 ]; then
    usage
fi

get_sapis() {
    if [ "$SAPI_FILTER" != "ALL" ]; then
        if [ ! -d "${CONF_ROOT}/${SAPI_FILTER}/conf.d" ]; then
            echo "Error: SAPI '${SAPI_FILTER}' is not installed." >&2
            exit 1
        fi
        echo "$SAPI_FILTER"
        return
    fi

    for dir in "${CONF_ROOT}"/*/conf.d; do
        [ -d "$dir" ] || continue
        basename "$(dirname "$dir")"
    done
}

SAPIS="$(get_sapis)"

for arg in "$@"; do
    mod="${arg%%/*}"
    override_prio=""
    if [ "$arg" != "$mod" ]; then
        override_prio="${arg#*/}"
    fi

    ini_file="${MODS_DIR}/${mod}.ini"
    if [ ! -f "$ini_file" ]; then
        [ "$QUIET" -eq 1 ] || echo "WARNING: Module ${mod} ini file doesn't exist under ${MODS_DIR}" >&2
        exit 1
    fi

    if [ -n "$override_prio" ]; then
        priority="$override_prio"
    else
        priority="$(sed -n 's/^[[:space:]]*;[[:space:]]*priority[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$ini_file" | head -n 1)"
        priority="${priority:-20}"
    fi

    for sapi in $SAPIS; do
        conf_dir="${CONF_ROOT}/${sapi}/conf.d"
        rm -f "${conf_dir}"/[0-9]*-"${mod}.ini"
        ln -sf "${ini_file}" "${conf_dir}/${priority}-${mod}.ini"
    done
done
